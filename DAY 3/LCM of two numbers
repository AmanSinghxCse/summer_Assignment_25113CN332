#include <iostream>
using namespace std;

int main (){
int num1,num2;
cout << " ENTER BOTH THE NUMBERS FOR FINDING LCM :";
cin >> num1 >> num2;

int a = num1, b = num2;

while ( num2 != 0){
    int temp = num2;
    num2 = num1 % num2;
    num1 = temp;
}
int gcd = num1;

int lcm = (a * b) / gcd;

cout << "THE LCM IS : " << lcm << endl;

    return 0;
}
